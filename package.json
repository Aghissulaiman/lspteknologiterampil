{
  "name": "lspteknologiterampil",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "db:setup": "npm run db:setup --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend --",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace backend",
    "db:migrate:status": "npm run db:migrate:status --workspace backend",
    "db:migrate:baseline": "npm run db:migrate:baseline --workspace backend",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:validate": "npm run prisma:validate --workspace backend",
    "db:seed": "node backend/scripts/db-seed.mjs",
    "db:bootstrap-admin": "node backend/scripts/bootstrap-admin.mjs",
    "db:import-json": "node backend/scripts/db-import-json.mjs"
  }
}
