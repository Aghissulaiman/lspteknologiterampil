{
  "name": "lspteknologiterampil-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --require ./scripts/tsx-windows-bootstrap.cjs --import tsx --watch server.ts",
    "start": "node --require ./scripts/tsx-windows-bootstrap.cjs --import tsx server.ts",
    "db:setup": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:baseline": "prisma migrate resolve --applied 20261118170000_init",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@next/env": "16.2.12",
    "@prisma/client": "7.10.1",
    "express": "^5.3.0",
    "file-type": "^19.6.0",
