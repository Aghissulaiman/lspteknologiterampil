  @@id([assessmentId, unitId], map: "assessment_unit_results_pkey")
  @@map("assessment_unit_results")
}

model AssessmentUnitEvidence {
  assessmentId String @map("assessment_id") @db.Uuid
  unitId       String @map("unit_id") @db.Uuid
  documentId   String @map("document_id") @db.Uuid

  result   AssessmentUnitResult @relation(fields: [assessmentId, unitId], references: [assessmentId, unitId], onDelete: Cascade, onUpdate: NoAction)
  document StoredDocument       @relation(fields: [documentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([assessmentId, unitId, documentId], map: "assessment_unit_evidence_pkey")
  @@map("assessment_unit_evidence")
}

model Certificate {
  id                String   @id @db.Uuid
  applicationId     String   @unique(map: "certificates_application_id_key") @map("application_id") @db.Uuid
  certificateNumber String   @unique(map: "certificates_certificate_number_key") @map("certificate_number") @db.VarChar(100)
  schemeName        String   @map("scheme_name") @db.VarChar(200)
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedBy          String   @map("issued_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application CertificationApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
