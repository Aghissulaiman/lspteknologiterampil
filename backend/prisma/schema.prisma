  @@index([actorId, createdAt(sort: Desc)], map: "audit_logs_actor_idx")
  @@map("audit_logs")
}

model SchemePayment {
  id                  String    @id @db.Uuid
  applicationId       String    @map("application_id") @db.Uuid
  participantId       String    @map("participant_id") @db.Uuid
  amount              String    @default("") @db.VarChar(50)
  bankName            String    @default("BCA") @map("bank_name") @db.VarChar(100)
  accountNumber       String    @default("8730921829") @map("account_number") @db.VarChar(50)
  accountHolder       String    @default("LSP TEKNOLOGI TERAMPIL") @map("account_holder") @db.VarChar(200)
  senderBank          String    @default("") @map("sender_bank") @db.VarChar(100)
  senderAccountName   String    @default("") @map("sender_account_name") @db.VarChar(200)
  senderAccountNumber String    @default("") @map("sender_account_number") @db.VarChar(50)
  transferAmount      String    @default("") @map("transfer_amount") @db.VarChar(50)
  proofDocumentId     String?   @map("proof_document_id") @db.Uuid
  status              String    @default("pending_payment") @db.VarChar(50)
  notes               String    @default("") @db.Text
  rejectionReason     String    @default("") @map("rejection_reason") @db.Text
  csWhatsapp          String    @default("+6281298765432") @map("cs_whatsapp") @db.VarChar(50)
  reviewedBy          String?   @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  application   CertificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participant   User                     @relation("SchemePaymentParticipant", fields: [participantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  proofDocument StoredDocument?          @relation("PaymentProof", fields: [proofDocumentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reviewer      User?                    @relation("SchemePaymentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([applicationId], map: "scheme_payments_application_idx")
  @@index([participantId], map: "scheme_payments_participant_idx")
  @@index([status], map: "scheme_payments_status_idx")
  @@map("scheme_payments")
}
