  @@index([tukSubmissionId, createdAt], map: "tuk_submission_status_history_app_idx")
  @@map("tuk_submission_status_history")
}

model Assessment {
  id                   String    @id @db.Uuid
  applicationId        String    @unique(map: "assessments_application_id_key") @map("application_id") @db.Uuid
  assessorId           String    @map("assessor_id") @db.Uuid
  assignedBy           String    @map("assigned_by") @db.Uuid
  preAssessmentOutcome String?   @map("pre_assessment_outcome") @db.Text
  preAssessmentNotes   String    @default("") @map("pre_assessment_notes") @db.Text
  assessmentNotes      String    @default("") @map("assessment_notes") @db.Text
  recommendation       String?   @db.Text
  recommendationNote   String?   @map("recommendation_note") @db.Text
  recommendedAt        DateTime? @map("recommended_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  application CertificationApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assessor    User                     @relation("AssessmentAssessor", fields: [assessorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assigner    User                     @relation("AssessmentAssigner", fields: [assignedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unitResults AssessmentUnitResult[]

  @@index([assessorId, createdAt(sort: Desc)], map: "assessments_assessor_idx")
  @@map("assessments")
}

model AssessmentUnitResult {
  assessmentId  String   @map("assessment_id") @db.Uuid
  unitId        String   @map("unit_id") @db.Uuid
  result        String?  @db.Text
  evidenceNotes String   @default("") @map("evidence_notes") @db.Text
  notes         String   @default("") @db.Text
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  assessment Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unit       CompetencyUnit           @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction)
